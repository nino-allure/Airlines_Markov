<Page x:Class="Airlines_Markov.Pages.Ticket"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Airlines_Markov.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="500" d:DesignWidth="800"
      MinHeight="500" MinWidth="800"
      Title="Управление Авиалиниями">

    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок с информацией о поиске -->
        <Grid Grid.Row="0" Background="#0041C2">
            <Label x:Name="SearchInfoLabel" 
                   Content="Результаты поиска" 
                   Foreground="White" 
                   FontSize="16" 
                   FontWeight="Bold" 
                   HorizontalAlignment="Center" 
                   VerticalAlignment="Center"/>
        </Grid>

        <!-- Список билетов -->
        <ScrollViewer Grid.Row="1" 
                      VerticalScrollBarVisibility="Auto" 
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="TicketsStackPanel" 
                        Margin="20,20,20,20" 
                        HorizontalAlignment="Center">

                <!-- Здесь будут динамически добавляться элементы билетов -->

                <!-- Сообщение, если билеты не найдены -->
                <TextBlock x:Name="NoTicketsMessage" 
                           Text="Билеты не найдены" 
                           FontSize="18" 
                           Foreground="Gray" 
                           HorizontalAlignment="Center" 
                           VerticalAlignment="Center" 
                           Visibility="Collapsed"
                           Margin="0,100,0,0"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
